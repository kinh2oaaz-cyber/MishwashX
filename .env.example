# ---------------------------------------------------------------------------
# Mishawash X — environment template
# Copy this file to `.env` and fill in values as needed.
#
# With no Supabase values the site and admin run in Local Studio mode:
# content is stored in this browser only. This is the default and is safe for
# design review, but it is not a real CMS backend.
# ---------------------------------------------------------------------------

# Supabase project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=

# Supabase anon/public key (Settings → API → anon public)
# NEVER put the service_role key here. It must never reach the browser.
VITE_SUPABASE_ANON_KEY=

# Base path for GitHub Pages project sites: /<repository-name>/
# Use / for user sites (username.github.io) and custom domains.
VITE_BASE_PATH=/
